<?xml version="1.0"?>
<robot name="test_robot">

  <gazebo>
    <static>false</static>
    <plugin name="gazebo_ros_force_system" filename="libgazebo_ros_force_system.so"/>
  </gazebo>

  <link name="base">
    <inertial>
      <mass value="10000.0"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1.0" iyy="1.0" izz="1.0" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <geometry><box size="0.5 0.5 0.1"/></geometry>
    </visual>
    <collision>
      <geometry><box size="0.5 0.5 0.1"/></geometry>
    </collision>
  </link>

  <joint name="base_arm_joint" type="revolute">
    <parent link="base"/>
    <child link="arm"/>
    <origin xyz="0 0 0.1"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" velocity="100" effort="10000"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>

  <link name="arm">
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0.5 0 0"/>
      <inertia ixx="0.1" iyy="0.1" izz="0.1" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="0.5 0 0"/>
      <geometry><box size="1.0 0.05 0.05"/></geometry>
    </visual>
    <collision>
      <origin xyz="0.5 0 0"/>
      <geometry><box size="1.0 0.05 0.05"/></geometry>
    </collision>
  </link>

</robot>
